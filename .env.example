# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=risk-engine
APP_VERSION=1.0.0

# ── Database ──────────────────────────────────────────────────────────────────
# asyncpg driver — used by SQLAlchemy 2.0
DATABASE_URL=postgresql+asyncpg://your_user:your_password@localhost:5432/risk_engine

POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=risk_engine

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Fraud engine thresholds ───────────────────────────────────────────────────
# Sliding-window velocity check
VELOCITY_WINDOW_SECONDS=300
VELOCITY_MAX_TRANSACTIONS=10
VELOCITY_CRITICAL_TRANSACTIONS=20

# Amount thresholds (BRL)
AMOUNT_HIGH_RISK_THRESHOLD=5000.00
AMOUNT_CRITICAL_THRESHOLD=20000.00

# Nighttime window (inclusive start, exclusive end — 24h format)
NIGHTTIME_START_HOUR=0
NIGHTTIME_END_HOUR=5

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
